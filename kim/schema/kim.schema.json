{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ege.local/schema/kim.schema.json",
  "title": "Вариант КИМ ЕГЭ (ТС ЕГЭ.РКИМ.ТЗ.001, раздел 7)",
  "type": "object",
  "required": ["variant", "examCode", "title", "tasks"],
  "additionalProperties": false,
  "properties": {
    "variant": { "type": "integer", "minimum": 1 },
    "examCode": { "enum": ["math-profile", "math-base"] },
    "title": { "type": "string", "minLength": 1 },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "number", "part", "topic_code", "type", "difficulty", "max_score", "content", "answer", "author"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "part": { "enum": [1, 2] },
        "topic_code": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
        "type": { "enum": ["short", "multiple_choice", "extended", "matching"] },
        "difficulty": { "enum": ["basic", "advanced", "high"] },
        "max_score": { "type": "integer", "minimum": 1, "maximum": 4 },
        "content": {
          "type": "object",
          "required": ["condition"],
          "additionalProperties": false,
          "properties": {
            "condition": { "type": "string", "minLength": 1 },
            "question": { "type": "string" },
            "options": { "type": "array", "items": { "type": "string" } },
            "image": { "type": "string" }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["integer", "decimal", "digits", "word"] },
            "compare": { "enum": ["number", "sequence", "set"] },
            "correct": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 50 } },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["score", "description"],
                "additionalProperties": false,
                "properties": { "score": { "type": "integer", "minimum": 0 }, "description": { "type": "string" } }
              }
            }
          }
        },
        "reference_ids": { "type": "array", "items": { "type": "string" } },
        "author": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "short" } } },
          "then": { "properties": { "answer": { "required": ["format", "compare", "correct"] } } } },
        { "if": { "properties": { "type": { "const": "extended" } } },
          "then": { "properties": { "answer": { "required": ["criteria"] } } } }
      ]
    }
  }
}
