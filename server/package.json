{
  "name": "@ege/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "STORAGE=memory node --import tsx --test src/*.test.ts src/kim/*.test.ts",
    "kim:validate": "tsx src/kim/validate-cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "seed:staging": "tsx src/cli.ts seed-staging"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "ajv": "^8.17.1",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
